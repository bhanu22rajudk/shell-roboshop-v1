#!/bin/bash

ami_id="ami-0055977a6e828a4f4"
instance_type="t3.micro"
domain_name="ecogiri.online"
hosted_zone_id="Z08319982HIIQSNLS6V08"


for instance in "$@"
do
    echo "creating instance: $instance"

    if ! instance_id=$(aws ec2 run-instances \
    --image-id "$ami_id" \
    --instance-type "$instance_type" \
    --security-groups "Roboshop-common" "Roboshop-$instance" \
	--tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=roboshop-$instance}]" \
	--query 'Instances[0].InstanceId' \
    --output text
    ); then
        echo "Failed to create $instance; skipping DNS update." >&2
        continue
    fi



    if [ -z "$instance_id" ] || [ "$instance_id" = "None" ]; then
        echo "No instance ID returned for $instance; skipping DNS update." >&2
        continue
    fi
    echo "$instance instance ID: $instance_id"

    if [ "$instance" != "frontend" ]; then
        IP=$( aws ec2 describe-instances --instance-ids "$instance_id" \
             --query 'Reservations[].Instances[].PrivateIpAddress' --output text
        )
        r53_record="${instance}.${domain_name}"
    else
        IP=$( aws ec2 describe-instances --instance-ids "$instance_id" \
             --query 'Reservations[].Instances[].PublicIpAddress' --output text
        )
        r53_record="${domain_name}"
    fi

    if [ -z "$IP" ] || [ "$IP" = "None" ]; then
        echo "No IP address returned for $instance; skipping DNS update." >&2
        continue
    fi

    # update R53 record
    echo "Record: ${r53_record}"
    if aws route53 change-resource-record-sets \
    --hosted-zone-id $hosted_zone_id \
    --change-batch '{
        "Changes": [
            {
                "Action": "UPSERT",
                "ResourceRecordSet": {
                    "Name": "'"$r53_record"'",
                    "Type": "A",
                    "TTL": 1,
                    "ResourceRecords": [{"Value": "'"$IP"'"}]
                }
            }
        ]
    }' \
    --output json
    then
        echo "Updated R53 record for $instance"
    else
        echo "Failed to update R53 record for $instance." >&2
    fi
    
done